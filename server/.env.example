# Server Port (default: 5000)
PORT=5000

# Frontend URL for CORS (default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# JWT Secret (auto-uses a dev fallback if omitted in development)
JWT_SECRET=your_super_secret_jwt_key_here

# Price cache duration in hours (default: 3)
CACHE_TTL_HOURS=3

# Optional: SerpApi key for live Google Shopping India prices
# Leave unset to run in Sample Mode
# SERPAPI_KEY=your_serpapi_key_here

# Optional: MongoDB connection string
# Leave unset to use local JSON file storage (/server/data/)
# MONGO_URI=mongodb://localhost:27017/smartdeal_ai

# Optional: Affiliate tags appended to store URLs when present
# AMAZON_AFFILIATE_TAG=smartdeal-21
# FLIPKART_AFFILIATE_ID=smartdeal

